# Git Ignore for SagaDrive

# Environment
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build
dist/
build/
.vite/

# MediaPipe WASM copied from node_modules by vendor script (#243).
# Model under public/mediapipe/models/ is committed as first-party artifact.
public/mediapipe/wasm/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary
*.tmp
*.temp
.cache/

# Item icon raster sources (Cursor-generated intermediates).
# Prefer gitignored PNGs; force-add (`git add -f`) only when running the
# GitHub vectorize workflow. Production assets are SVG under public/assets/items/.
assets/item-icon-sources/*.png
assets/item-icon-sources/*.jpg
assets/item-icon-sources/*.jpeg
!assets/item-icon-sources/.gitkeep
assets/npc-creature-icon-sources/*.png
assets/npc-creature-icon-sources/*.jpg
assets/npc-creature-icon-sources/*.jpeg
!assets/npc-creature-icon-sources/.gitkeep

# Playwright / QA artifacts
playwright-report/
.qa/test-results/
test-results/

# Agent runner session state (per-session bookkeeping, not project state)
.qa/queue/

# Docker
.docker/
docker-compose.override.yml

# Species 3D exploration boards + Meshy preview intermediates (golden + public GLBs are committed)
assets/species-3d/**/style-compare/
assets/species-3d/**/style-compare-v2/
assets/species-3d/**/*-preview.glb
assets/species-3d/**/*_textures/
assets/species-3d/**/*-underwear-ref.png
assets/species-3d/**/*-ref.png
!assets/species-3d/**/golden/
!assets/species-3d/**/golden/**
assets/species-3d/**/*.glb

# LiveAct Golden Reference VRM (~68MB LFS upstream) — fetch via scripts/fetch-liveact-reference-vrm.mjs
public/assets/avatars/reference/*.vrm
# Saga Human Canonical V1 PoC VRM (~10MB, deterministic) — npm run build:saga-human-canonical-v1
public/assets/avatars/canonical/*.vrm
