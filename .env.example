# ===========================================
# SagaDrive Self-Host Configuration
# Copy this file to .env and fill in values
# ===========================================

# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-change-me-in-production

# PostgreSQL Password
POSTGRES_PASSWORD=your-super-secret-password-change-me

# Generate with: openssl rand -base64 32
SUPABASE_ANON_KEY=your-anon-key-change-me
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-change-me

# Frontend Supabase connection. VITE_SUPABASE_ANON_KEY must match SUPABASE_ANON_KEY above.
# Configure both VITE values together so the browser uses the self-hosted gateway.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-anon-key-change-me

# Site URL
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/auth/callback

# SMTP (optional, for email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_ADMIN_EMAIL=admin@example.com

# Email confirmation (set to false for production)
MAILER_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# Neo4j Password
NEO4J_PASSWORD=your-neo4j-password-change-me

# Ollama defaults used by existing AI features
OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://ollama:11434

# Character background AI
# Supported providers: ollama | openai-compatible
CHARACTER_AI_PROVIDER=ollama
# Optional: falls back to OLLAMA_MODEL when omitted
# CHARACTER_AI_MODEL=llama3.2
# Optional for Ollama: falls back to OLLAMA_HOST and then http://ollama:11434
# Required for openai-compatible providers
# CHARACTER_AI_BASE_URL=http://ollama:11434
# Required only for openai-compatible providers. Keep the real value in server secrets.
# CHARACTER_AI_API_KEY=
# Enforced persistently across Edge Runtime instances by migration 003 + service-role RPC.
CHARACTER_AI_RATE_LIMIT_PER_MINUTE=6
# CORS for character-lore Edge Function (fail-closed, never defaults to *):
# - Leave unset for local Vite only (localhost / 127.0.0.1)
# - Production: set exact origin(s), comma-separated
# - Explicit "*" only when intentionally allowing any origin
CHARACTER_AI_ALLOWED_ORIGIN=http://localhost:3004
